<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Base theme: No ActionBar, transparent system bars for edge-to-edge Compose content.
      Compose handles all UI theming via DevInfoTheme; this only affects the window chrome.

      windowBackground 与启动屏同色，Compose 首帧之前不会闪一帧异色底。
      暗色分支见 values-night/themes.xml —— 两者除明暗标志外必须保持一致。
    -->
    <style name="Theme.DevInfo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <!-- Transparent status/navigation bars for edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 边到边内容自己负责对比度，不需要系统在半透明栏下再叠一层遮罩。 -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- 启动屏主题（浅色） -->
    <style name="Theme.DevInfo.Splash" parent="Theme.SplashScreen">
        <!-- 启动屏结束后显示的主主题 -->
        <item name="postSplashScreenTheme">@style/Theme.DevInfo</item>
        <!-- 启动屏背景色 -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- 启动屏图标（使用应用图标的 foreground 层） -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">320</item>
    </style>


</resources>
