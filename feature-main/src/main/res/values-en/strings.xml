    <string name="root_help_apatch_steps">Tap the Root entry in DevInfo to send one request\nAllow DevInfo in the APatch superuser list\nReturn to DevInfo and retry</string>
    <string name="root_help_apatch_title">APatch</string>
    <string name="root_help_intro">Root monitoring in DevInfo needs to be authorized in your root manager. These are the steps for common managers; if you do not see yours, follow the same idea with the manager installed on your device.</string>
    <string name="root_help_ksu_note">DevInfo missing from the list does not prove the request never arrived: KernelSU writes no kernel log for su requests, and the list itself is cached.</string>
    <string name="root_help_ksu_steps">Tap the Root entry in DevInfo to send one request\nOpen the KernelSU manager\nIf DevInfo is missing from the superuser list, force-stop and restart the manager first\nOpen the DevInfo details page and turn on the superuser switch\nReturn to DevInfo and tap retry</string>
    <string name="root_help_ksu_title">KernelSU</string>
    <string name="root_help_magisk_steps">Tap the Root entry in DevInfo to send one request\nOpen the Magisk app\nAllow DevInfo in the superuser list\nReturn to DevInfo and retry</string>
    <string name="root_help_magisk_title">Magisk</string>
